<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
  https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
  version="6.0"
  metadata-complete="true">
  
    <display-name>Projet Cinema</display-name>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/log</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FormClientServlet</servlet-name>
        <servlet-class>controller.FormClientServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>FormClientServlet</servlet-name>
        <url-pattern>/formulaireClient</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ClientServlet</servlet-name>
        <servlet-class>controller.ClientServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>ClientServlet</servlet-name>
        <url-pattern>/clients</url-pattern>
    </servlet-mapping>

    <!-- 
     -->
     <!-- 
      -->

    <servlet>
        <servlet-name>FormFilmServlet</servlet-name>
        <servlet-class>controller.FormFilmServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>FormFilmServlet</servlet-name>
        <url-pattern>/formulaireFilm</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FilmServlet</servlet-name>
        <servlet-class>controller.FilmServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>FilmServlet</servlet-name>
        <url-pattern>/films</url-pattern>
    </servlet-mapping>


    <!-- 
     -->
     <!-- 
      -->

    <servlet>
        <servlet-name>FormReservationServlet</servlet-name>
        <servlet-class>controller.FormReservationServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>FormReservationServlet</servlet-name>
        <url-pattern>/formulaireRes</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReservationServlet</servlet-name>
        <servlet-class>controller.ReservationServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>ReservationServlet</servlet-name>
        <url-pattern>/lesreservation</url-pattern>
    </servlet-mapping>

    <!-- 
     -->
     <!--  -->

    <servlet>
        <servlet-name>FormSeanceServlet</servlet-name>
        <servlet-class>controller.FormSeanceServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>FormSeanceServlet</servlet-name>
        <url-pattern>/formulaireSeance</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SeanceServlet</servlet-name>
        <servlet-class>controller.SeanceServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>SeanceServlet</servlet-name>
        <url-pattern>/seances</url-pattern>
    </servlet-mapping>


    <welcome-file-list>
        <welcome-file>view/home.jsp</welcome-file>
    </welcome-file-list>

</web-app>
